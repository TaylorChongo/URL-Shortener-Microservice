APP_ENV=development
DEBUG=True
BASE_URL=http://127.0.0.1:8000
POSTGRES_USER=shortener
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shortener
DATABASE_URL=postgresql+psycopg://shortener:change-me@127.0.0.1:5433/shortener

# signs the JWT tokens. Generate your own: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
